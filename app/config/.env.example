# Salin file ini ke .env di ROOT proyek, bukan di public/ atau app/config/.
# Environment proses lebih diutamakan daripada isi file ini.
# Nilai dengan spasi/# boleh diapit tanda kutip. Tidak ada ekspansi ${VAR}.
APP_NAME="Sistem Absensi Siswa Berbasis QR Code"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/Absensi-Siswa-i/public
APP_TIMEZONE=Asia/Jakarta
SESSION_COOKIE_PATH=/
# Buat secret acak privat (min. 32 byte) dengan: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=absensi_qr_sekolah
# Isi username dan password database milik lingkungan lokal sendiri.
DB_USERNAME=
DB_PASSWORD=
